{
    "name": "pi-claude-commands",
    "version": "2.0.0",
    "description": "Bridge Claude Code commands (.claude/commands/) into pi as slash commands with nested folder support (/jira/plan, /jira/assess-risks, etc.)",
    "type": "module",
    "keywords": [
        "pi-package",
        "pi-extension",
        "claude",
        "commands",
        "bridge"
    ],
    "license": "MIT",
    "pi": {
        "extensions": ["./index.ts"]
    },
    "scripts": {
        "test": "npx tsx --test test/*.test.ts"
    },
    "peerDependencies": {
        "@earendil-works/pi-coding-agent": "*"
    },
    "peerDependenciesMeta": {
        "@earendil-works/pi-coding-agent": {
            "optional": true
        }
    }
}
